{
  "$defs": {
    "_Method": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:]+\\.java$",
          "title": "Path",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "class_name": {
          "minLength": 1,
          "title": "Class Name",
          "type": "string"
        }
      },
      "required": [
        "path",
        "name",
        "line",
        "class_name"
      ],
      "title": "_Method",
      "type": "object"
    },
    "_Test": {
      "additionalProperties": false,
      "properties": {
        "test": {
          "$ref": "#/$defs/_Method"
        },
        "calls": {
          "items": {
            "$ref": "#/$defs/_Method"
          },
          "title": "Calls",
          "type": "array"
        }
      },
      "required": [
        "test",
        "calls"
      ],
      "title": "_Test",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "revision": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Revision",
      "type": "string"
    },
    "coverage_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Coverage Sha256",
      "type": "string"
    },
    "build_id": {
      "minLength": 1,
      "title": "Build Id",
      "type": "string"
    },
    "scope": {
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "tests": {
      "items": {
        "$ref": "#/$defs/_Test"
      },
      "title": "Tests",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "revision",
    "coverage_sha256",
    "build_id",
    "scope",
    "complete",
    "tests"
  ],
  "title": "_Trace",
  "type": "object"
}
